{
  "name": "@mata-kota/ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/run-python.mjs scripts/check-syntax.py",
    "dev": "node scripts/run-python.mjs -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "setup": "node scripts/run-python.mjs -m pip install -e .[dev]",
    "start": "node scripts/run-python.mjs -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "node scripts/run-python.mjs -m pytest -q"
  }
}
