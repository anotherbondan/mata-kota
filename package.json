{
  "name": "mata-kota",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @mata-kota/db",
    "db:studio": "turbo run db:studio -F @mata-kota/db",
    "db:generate": "turbo run db:generate -F @mata-kota/db",
    "db:migrate": "turbo run db:migrate -F @mata-kota/db",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@mata-kota/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@mata-kota/config": "workspace:*",
    "@types/node": "^22.13.14",
    "husky": "latest",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "ultracite": "7.9.3"
  },
  "packageManager": "pnpm@10.28.0"
}
